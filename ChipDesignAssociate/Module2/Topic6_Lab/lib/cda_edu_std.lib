/* --------------------------------------------------------------------
 * cda_edu_std.lib  -  GENERATED FILE. Do not edit; edit cda_edu.lib and
 * re-run  python3 scripts/mklib_std.py  instead.
 *
 * A standards-compliant Liberty view of the teaching library, for tools
 * that reject the custom cda_* attributes (OpenSTA, PrimeTime, ...).
 * The delay numbers are identical to cda_edu.lib, so the two reports
 * can be compared line by line.
 * ----------------------------------------------------------------- */

library (cda_edu_std) {
  technology (cmos);
  delay_model              : table_lookup;
  time_unit                : "1ns";
  voltage_unit             : "1V";
  current_unit             : "1mA";
  pulling_resistance_unit  : "1kohm";
  leakage_power_unit       : "1nW";
  capacitive_load_unit     (1, pf);
  nom_voltage              : 1.20;
  nom_temperature          : 25.0;
  nom_process              : 1.0;
  default_max_transition   : 1.0;

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.05, 0.20");
    index_2 ("0.00, 1.50, 3.00, 6.00, 12.00");
  }
  lu_table_template (constraint_template) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.05, 0.20");
    index_2 ("0.05, 0.20");
  }

  cell (AND2) {
