    pin (A) { direction : input; capacitance : 1.20; }
    pin (B) { direction : input; capacitance : 1.20; }
    pin (Y) {
      direction : output;
      function  : "(A B)";
      max_capacitance : 16.0;
      timing () {
        related_pin  : "A";
        timing_sense : positive_unate;
        cell_rise (delay_template) {
          values("0.0530, 0.0710, 0.0890, 0.1250, 0.1970", \
                 "0.0530, 0.0710, 0.0890, 0.1250, 0.1970");
